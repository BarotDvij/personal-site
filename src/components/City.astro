---
// Shell for Dvij City. The engine is loaded only when a visitor opens the tour.
---

<section class="city" id="city" aria-label="Dvij City, an explorable map of Dvij's work" tabindex="-1">
  <canvas class="city-canvas" aria-hidden="true"></canvas>
  <div class="city-overlay" role="group" aria-label="Buildings"></div>

  <header class="hud">
    <div class="hud-left">
      <span class="hud-title">Dvij City</span>
      <span class="hud-district" data-hud-district>Welcome Plaza</span>
    </div>
    <p class="hud-score" data-hud-score aria-live="off"></p>
    <div class="hud-right">
      <button type="button" class="hud-btn" data-open-settings aria-haspopup="dialog">Settings</button>
      <button type="button" class="hud-btn" data-set-mode="cv">Read the article</button>
    </div>
  </header>

  <nav class="minimap" aria-label="Districts">
    <div class="minimap-view" aria-hidden="true"></div>
  </nav>

  <div class="welcome" role="note">
    <p class="welcome-title">Welcome to Dvij City</p>
    <p>Every building is a role or a project I built. The copper pipes underground are data pipelines.</p>
    <p class="welcome-keys">Scroll, drag, or use arrow keys to explore. Click a building to open it.</p>
    <button type="button" class="px-btn">Start exploring</button>
  </div>

  <dialog class="city-panel" aria-labelledby="panel-title">
    <form method="dialog" class="panel-close-form">
      <button class="panel-close" aria-label="Close">X</button>
    </form>
    <p class="panel-kicker"></p>
    <h2 class="panel-title" id="panel-title"></h2>
    <div class="panel-body"></div>
  </dialog>
</section>
