---
// Draws the portrait from src/data/portrait.ts at build time. Each colour is
// one SVG path made of horizontal runs, so the page ships no image file and
// the portrait shows even with JavaScript turned off.
import { PALETTE, PIXELS } from '../data/portrait';

interface Props { alt: string; size?: number }
const { alt, size = 192 } = Astro.props;

const h = PIXELS.length, w = PIXELS[0].length;
// The most common colour fills the background, so it needs no runs.
const counts = PALETTE.map((_, i) => PIXELS.reduce((n, row) => n + row.split(String(i)).length - 1, 0));
const base = counts.indexOf(Math.max(...counts));
const paths = PALETTE.map(() => [] as string[]);
PIXELS.forEach((row, y) => {
  let x = 0;
  while (x < w) {
    const c = +row[x];
    let n = 1;
    while (x + n < w && row[x + n] === row[x]) n++;
    if (c !== base) paths[c].push(`M${x} ${y}h${n}v1h-${n}z`);
    x += n;
  }
});
---
<svg
  class="portrait photo"
  viewBox={`0 0 ${w} ${h}`}
  width={size}
  height={size}
  role="img"
  aria-label={alt}
  shape-rendering="crispEdges"
>
  <rect width={w} height={h} fill={PALETTE[base]} />
  {paths.map((d, i) => (d.length ? <path fill={PALETTE[i]} d={d.join('')} /> : null))}
</svg>
