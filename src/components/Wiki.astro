---
import profile from '../../content/profile.json';
import Cite from './Cite.astro';
import PixelIcon from './PixelIcon.astro';
import Org from './Org.astro';
import Award from './Award.astro';
import { STRUCTURES } from '../scripts/city/world';

// Map each role and project to its building so the Wiki can link into the city.
const buildingFor = (match: (r: NonNullable<(typeof STRUCTURES)[number]['ref']>) => boolean) =>
  STRUCTURES.find((s) => s.ref && match(s.ref))?.id;
const roleBuilding = (org: string) => buildingFor((r) => r.type === 'role' && r.org === org);
const projectBuilding = (name: string) => buildingFor((r) => r.type === 'project' && r.name === name);

// Footnotes: every claim that has public proof gets a citation.
const refs: { id: string; label: string; href: string }[] = [];
const cite = (label: string, href: string) => {
  let i = refs.findIndex((r) => r.href === href);
  if (i < 0) {
    refs.push({ id: `ref-${refs.length + 1}`, label, href });
    i = refs.length - 1;
  }
  return i + 1;
};

const cityscapes = cite('CityScapes on Devpost', 'https://devpost.com/software/cityscape-b02jei');
// Cited in order of first appearance on the page (infobox, then the lead).
const summitProject = profile.projects.find((p) => p.name === 'SUMMIT Financial Learning')!;
const summit = cite(`${summitProject.name} source`, summitProject.links.code);
const urbanMarble = cite('Urban Marble on Devpost', 'https://devpost.com/software/urban-marble');
// Early life & education comes before Projects, so its refs are created first.
const wlooNews = cite('Embracing change, Waterloo Management Science and Engineering', 'https://uwaterloo.ca/management-science-engineering/news/embracing-change');
const wlooCalendar = cite('Management Engineering, Waterloo Undergraduate Calendar', 'https://uwaterloo.ca/academic-calendar/undergraduate-studies/catalog#/programs/HkzsJ1CRsh');
const projectRefs = profile.projects.map((p) => {
  const href = 'devpost' in p.links && p.links.devpost ? (p.links.devpost as string) : p.links.code;
  return cite(`${p.name} source`, href);
});

// Awards come after Projects, so their refs follow the project ones. Personal life reuses the DECA refs.
const decaDoc = cite('DECA Ontario, Marketing Competency (MC) document', 'https://deca.ca/documents/MC.pdf');
const decaVideo = cite('DECA Provincials Awards Ceremony Medal Appearance', 'https://youtu.be/2vD2lEhETNU?si=75cFrAoT5XMPi-X_&t=5589');
const velocity = cite('Velocity Pitch Competition semi-finalist post on LinkedIn', 'https://lnkd.in/p/gmE37jkp');
const raas2023 = cite('Battle of the Raas 2023 on Instagram', 'https://www.instagram.com/p/CqXCP8uOTdG/?img_index=1');
const raas2024 = cite('Battle of the Raas 2024 on Instagram', 'https://www.instagram.com/p/C4Y49-KJeGZ/?img_index=1');
// Inline citation markup for the award paragraphs, which are written as HTML strings.
const ref = (n: number) => `<sup class="cite"><a href="#ref-${n}" aria-label="Reference ${n}">[${n}]</a></sup>`;

// Influences comes after Projects, so its refs are created after the project ones.
const wikiHistory = cite('History of Wikipedia', 'https://en.wikipedia.org/wiki/History_of_Wikipedia');
const mediaWiki = cite('MediaWiki', 'https://en.wikipedia.org/wiki/MediaWiki');
const citationNeeded = cite('Wikipedia:Citation needed', 'https://en.wikipedia.org/wiki/Wikipedia:Citation_needed');
const wikimedia = cite('Wikimedia Foundation', 'https://en.wikipedia.org/wiki/Wikimedia_Foundation');
const fourthGen = cite('History of video game consoles (fourth generation)', 'https://en.wikipedia.org/wiki/History_of_video_game_consoles_(fourth_generation)');
const mode7 = cite('Mode 7', 'https://en.wikipedia.org/wiki/Mode_7');
const strongTowns = cite('Strong Towns', 'https://www.strongtowns.org/');

const current = profile.experience[0];
const sections = [
  ['early-life', 'Early Life & Education'],
  ['career', 'Career'],
  ['projects', 'Projects'],
  ['awards', 'Awards'],
  ['civic', 'Personal life'],
  ['influences', 'Influences'],
  ['references', 'References'],
];

// Junior Achievement awards sit with the business competitions. Dance and Velocity are covered
// in prose only, so they have no list entries. Award names are italic.
const awardSections = [
  {
    title: 'Business competitions',
    groups: ['Business competitions', 'Junior Achievement'],
    intro: `Dvij competed in <a href="https://deca.ca/v2/">DECA</a> from 2017 to 2021.${ref(decaDoc)} His regional awards covered Marketing Communications (2017), the marketing cluster test across 14 series (2018), Retail Merchandising and the marketing cluster test (2019), and a top 20 finish out of 237 competitors overall in Retail Merchandising (2020). At the provincial level, he placed in the top 15 for the first Retail Merchandising case competition (2020) and for the marketing cluster test (2019), and in the top 15 highest scores in the Retail Merchandising series (2021).${ref(decaVideo)} In 2021, he was selected as one of two representatives from the Huron Area at the Believe Initiative Collective Fair, which placed his project among the top 24 in North America. In 2024, he was a semi-finalist at the <i>Velocity Pitch Competition</i>.${ref(velocity)}`,
    intro2: `With <a href="https://jaswo.org/">Junior Achievement Waterloo</a>, he won <i>Salesperson of the Year</i>, <i>Production Company of the Year</i>, and <i>Company of the Year</i> in 2019. <i>Salesperson of the Year</i> went to the student who generated the most sales revenue in the charter. <i>Production Company of the Year</i> recognized the best product overall, judged on quality, creativity, and utility, and he led the production team as VP of Production. <i>Company of the Year</i> recognized the company that best epitomized entrepreneurship, innovation, and collaboration while running a financially successful business. In 2018, he won the <i>Product Design Award</i> for the most innovative product in the charter and <i>VP of Marketing of the Year</i>, which goes to the single VP of Marketing who best embodies leadership, innovation, and collaboration. In 2019, he was also one of two students chosen to represent Junior Achievement Waterloo internationally, where his team's response to a real company's business challenge was judged the most effective and won the <i>International Youth Success Summit</i> challenge.`,
  },
  {
    title: 'School',
    groups: ['School'],
    intro: `At Rickson Ridge Public School, Dvij was one of two students voted by teachers and classmates to speak at graduation in 2017, and he also won the excellence in math, history, and social justice awards. At Huron Heights Secondary School, he received the <i>Dustin Picard Memorial Award of Integrity</i> in 2021, which is presented to a student who exemplifies the spirit of unfailing friendship, courage to stand up for people, respect for individuality, and above all, integrity.`,
  },
  {
    title: 'Dance',
    groups: [] as string[],
    intro: `Dvij won first place at RaasMotion's <i>Battle of the Raas</i> dance competition in consecutive years 2023 and 2024.${ref(raas2023)}${ref(raas2024)}`,
  },
].map((g) => ({ ...g, items: profile.awards.filter((a) => g.groups.includes(a.group)) }));

const anchor = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<div class="wiki" id="wiki">
  <a class="skip" href="#article">Skip to article</a>
  <header class="wiki-bar">
    <button type="button" class="toc-toggle" aria-controls="toc" aria-expanded="false" aria-label="Contents">
      <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" shape-rendering="crispEdges">
        <path d="M2 3h2v2H2zM6 3h8v2H6zM2 7h2v2H2zM6 7h8v2H6zM2 11h2v2H2zM6 11h8v2H6z" fill="currentColor" />
      </svg>
    </button>
    <a class="wordmark" href="/" aria-label="dvijbarot.wiki home">
      <svg viewBox="0 0 16 16" width="28" height="28" aria-hidden="true" shape-rendering="crispEdges">
        <rect width="16" height="16" fill="var(--ink)" />
        <path d="M3 3h6v1h1v1h1v6h-1v1h-1v1H3zM5 5v6h3v-1h1V6H8V5z" fill="var(--paper)" />
        <rect x="12" y="11" width="2" height="2" fill="#e8c547" />
      </svg>
      <span>dvijbarot<b>.wiki</b></span>
    </a>
    <div class="bar-actions">
      <button type="button" class="ghost" data-open-settings aria-haspopup="dialog">Settings</button>
    </div>
  </header>

  <nav class="tabs" aria-label="Article views">
    <div class="tab-group">
      <a href="#article" aria-current="page">Article</a>
      <a href="#talk">Talk</a>
    </div>
    <div class="tab-group">
      <a href="#career">View history</a>
    </div>
  </nav>

  <div class="wiki-body">
  <nav class="toc" id="toc" aria-label="Contents">
    <div class="toc-title">Contents <button type="button" class="toc-hide" aria-controls="toc">hide</button></div>
    <ol>
      <li><a href="#article" data-toc="article">(Top)</a></li>
      {sections.map(([id, name]) => <li><a href={`#${id}`} data-toc={id}>{name}</a></li>)}
    </ol>
  </nav>

  <main class="article" id="article" tabindex="-1">
    <div class="sitenotice">
      <button type="button" class="notice-thumb" data-set-mode="city" aria-label="Open Dvij City">
        <img src="/city-banner.webp" alt="" width="5848" height="460" />
      </button>
      <div class="notice-text">
        <p><b>This article is also a city.</b> Every role and project below is a building you can walk into, with data pipelines running underground.</p>
        <button type="button" class="tour-btn" data-set-mode="city">
          <span class="px-icon" aria-hidden="true"></span> Explore Dvij City
        </button>
      </div>
    </div>

    <div class="title-row">
      <h1>{profile.name}</h1>
      <nav class="title-links" aria-label="Contact and profiles">
        <a href={profile.links.github} aria-label="GitHub" title="GitHub"><PixelIcon name="github" /></a>
        <a href={profile.links.devpost} aria-label="Devpost" title="Devpost"><PixelIcon name="devpost" /></a>
        <a href={profile.links.linkedin} aria-label="LinkedIn" title="LinkedIn"><PixelIcon name="linkedin" /></a>
        <a href={`mailto:${profile.links.email}`} aria-label={`Email ${profile.links.email}`} title="Email"><PixelIcon name="mail" /></a>
      </nav>
    </div>
    <p class="from">From dvijbarot.wiki, a living article about one builder</p>

    <aside class="infobox" aria-label="Quick facts">
      <div class="infobox-title">{profile.name}</div>
      {profile.photo.src ? (
        <img class="portrait photo" src={profile.photo.src} alt={profile.photo.alt} width="192" height="192" />
      ) : (
        <div class="portrait" role="img" aria-label="Portrait coming soon">
          <span>DB</span>
        </div>
      )}
      <p class="caption">Waterloo, Ontario</p>
      <button type="button" class="locator" data-set-mode="city" aria-label="Location in Dvij City. Open the city">
        <img src="/city-locator-night.webp" alt="" width="1440" height="512" loading="lazy" />
        <span class="pin" aria-hidden="true"></span>
      </button>
      <p class="caption">Location in Dvij City. <button type="button" class="linklike" data-set-mode="city">Explore</button></p>
      <table>
        <tbody>
          <tr><th scope="row">Occupation</th><td>{current.role}, <Org e={current} /></td></tr>
          <tr><th scope="row">Education</th><td><a href={profile.education.url}>{profile.education.school}</a><br /><small>{profile.education.degree}</small></td></tr>
          <tr><th scope="row">Disciplines</th><td>Product · Data · AI · Software · Marketing</td></tr>
          <tr>
            <th scope="row">Known for</th>
            <td>
              <ul>
                <li>0 to 1 product development</li>
                <li>Automating workflows</li>
                <li>Evaluation-driven agents</li>
                <li>3 hackathon wins in 7 days<Cite n={cityscapes} /><Cite n={urbanMarble} /></li>
              </ul>
            </td>
          </tr>
          <tr>
            <th scope="row">Links</th>
            <td class="infobox-links">
              <a href={profile.links.linkedin}>LinkedIn</a>
              <a href={profile.links.github}>GitHub</a>
              <a href={profile.links.devpost}>Devpost</a>
            </td>
          </tr>
        </tbody>
      </table>
    </aside>

    <p class="lead" id="talk">
      <b>Dvij Barot</b> is a Management Engineering student at the <a href={profile.education.url}>{profile.education.school}</a> looking for {profile.seeking}. He can be contacted <i>via email at <a href={`mailto:${profile.links.email}`}>{profile.links.email}</a> or on LinkedIn at <a href={profile.links.linkedin}>linkedin.com/in/barotdvij</a></i>.
    </p>
    <p class="lead-more">
      Barot is currently holding the <b>{current.role}</b> position at <Org e={current} />, <Fragment set:html={current.now} />. His work spans AI engineering and enablement, program, project, and <a href="https://en.wikipedia.org/wiki/Product_management">product management</a>, <a href="https://en.wikipedia.org/wiki/Data_engineering">data engineering</a>, <a href="https://en.wikipedia.org/wiki/Search_engine_optimization">SEO</a>, <a href="https://en.wikipedia.org/wiki/Generative_engine_optimization">GEO</a>, <a href="https://en.wikipedia.org/wiki/Marketing_strategy">marketing strategy</a>, and <a href="https://en.wikipedia.org/wiki/Software_development">software development</a>. His work has touched <a href="https://en.wikipedia.org/wiki/Pipeline_(computing)">data pipelines</a>, marketing channels, web platforms, <a href="https://en.wikipedia.org/wiki/Software_agent">agent harnesses</a>, and full-stack products<Cite n={summit} />. Barot's working philosophy is summed up in one line: "{profile.philosophy}"
    </p>

    <section id="early-life" aria-labelledby="early-h">
      <h2 id="early-h">Early Life &amp; Education</h2>
      <p>
        Dvij Barot was born in <a href="https://en.wikipedia.org/wiki/Scarborough,_Toronto">Scarborough</a>, Ontario. He moved to <a href="https://en.wikipedia.org/wiki/Guelph">Guelph</a>, Ontario at four years of age, where he completed his primary schooling. He moved to <a href="https://en.wikipedia.org/wiki/Kitchener%E2%80%93Waterloo">Kitchener-Waterloo</a>, Ontario when he turned 14, where he attended Huron Heights Secondary School.
      </p>
      <p>
        Currently, Dvij is in his third year of his undergraduate degree at the <a href={profile.education.url}>University of Waterloo</a> in the <a href="https://uwaterloo.ca/engineering/future-students/management-engineering">Management Engineering</a> program.{' '}
        Management Engineering is often described as a combination of <a href="https://en.wikipedia.org/wiki/Software_engineering">software engineering</a> and <a href="https://en.wikipedia.org/wiki/Industrial_engineering">industrial engineering</a>, with the University of Waterloo's program being considered a pioneer in the modernization of the field<Cite n={wlooNews} />. Courses include Databases and Software Design, Probability and Statistics II, Algorithms and Data Structures, Modelling in Operations Research, Introduction to Machine Learning, and Organizational Behaviour<Cite n={wlooCalendar} />.
      </p>
    </section>

    <section id="career" aria-labelledby="career-h">
      <h2 id="career-h">Career</h2>
      <ul class="awards">
        {profile.experience.map((e) => (
          <li id={anchor(e.org)}>
            <b><Org e={e} /></b> <span class="award-meta">{e.role} · {e.place}</span>
            <br />{e.summary}
            {roleBuilding(e.org) && (
              <>
                {' '}
                <a class="city-link" href={`#tour/${roleBuilding(e.org)}`} data-city-target={roleBuilding(e.org)} aria-label={`See ${e.org} in Dvij City`}>See it in Dvij City</a>
              </>
            )}
          </li>
        ))}
      </ul>
    </section>

    <section id="projects" aria-labelledby="projects-h">
      <h2 id="projects-h">Projects</h2>
      <div class="project-grid">
        {profile.projects.map((p, i) => (
          <article class="project">
            <h3>
              {p.name}
              <Cite n={projectRefs[i]} />
            </h3>
            {'award' in p && p.award && <p class="award">{p.award}</p>}
            {'status' in p && p.status && <p class="award status">{p.status}</p>}
            <p>{p.tagline}</p>
            <p class="stack">{p.stack.join(' · ')}</p>
            {projectBuilding(p.name) && (
              <a class="city-link" href={`#tour/${projectBuilding(p.name)}`} data-city-target={projectBuilding(p.name)}>See it in Dvij City</a>
            )}
          </article>
        ))}
      </div>
    </section>

    <section id="awards" aria-labelledby="awards-h">
      <h2 id="awards-h">Awards</h2>
      <h3>Hackathons</h3>
      <table class="wikitable">
        <caption>Results from one week in 2026</caption>
        <thead><tr><th scope="col">Place</th><th scope="col">Event</th><th scope="col">Project</th></tr></thead>
        <tbody>
          {profile.hackathons.map((h) => (
            <tr>
              <td class={`place ${h.place === '1st' ? 'gold' : 'silver'}`}>{h.place}</td>
              <td>{h.event}</td>
              <td>{'link' in h && h.link ? <a href={h.link as string}>{h.project}</a> : h.project}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {awardSections.map((g) => (
        <>
          <h3>{g.title}</h3>
          <p set:html={g.intro} />
          {g.intro2 && <p set:html={g.intro2} />}
          {g.items.length > 0 && (
            <ul class="awards">
              {g.items.map((a) => (
                <li>
                  <Award award={a} />
                </li>
              ))}
            </ul>
          )}
        </>
      ))}
      <a class="city-link" href="#tour/halloffame" data-city-target="halloffame">See the trophy case in Dvij City</a>
    </section>

    <section id="civic" aria-labelledby="civic-h">
      <h2 id="civic-h">Personal life</h2>
      <p>
        In high school, Dvij was known to be one of the only drummers in the school, which meant he took part in all of the school bands and concerts (Jr. Band, Sr. Band, Jazz Band, and the MYART concert) by default. He was also the sole winner from his school's chapter in the <a href="https://deca.ca/v2/">DECA</a> competition at the provincial level for three consecutive years, and the only student to take part in the international competition (ICDC) during his time at the school<Cite n={decaDoc} /><Cite n={decaVideo} />. He graduated with distinction from Huron Heights Secondary School and won the Dustin Picard Memorial Award of Integrity, a graduation award presented to a student who exemplifies the spirit of unfailing friendship, courage to stand up for people, respect for individuality, and above all, integrity. In university, he has been part of the Wat.AI Engineering Design Team and the Warriors Dance Team, and served as Hindu Yuva (formerly Hindu Students Council) President.
      </p>
      <p>
        Dvij has also been active in his community, particularly in Kitchener. He helped pass a bylaw at Kitchener City Hall to allow fireworks during Diwali, and as Hindu Yuva President, he set up a food bank drive with the City of Kitchener. Back in high school, he also volunteered at City Hall for the Junior Achievement Fish Tank camp, an entrepreneurial and financial literacy program for kids and pre-teens.
      </p>
      <a class="city-link" href="#tour/cityhall" data-city-target="cityhall">See it in Dvij City</a>
    </section>

    <section id="influences" aria-labelledby="influences-h">
      <h2 id="influences-h">Influences</h2>
      <p>The ideas behind this site came from the games, websites, and cities Dvij grew up with.</p>

      <h3>Wikipedia</h3>
      <p>Dvij read <a href="https://en.wikipedia.org/wiki/Wikipedia">Wikipedia</a> for hours as a kid, and it was the first recurring donation he set up once he started earning, which is why this site is a wiki. Launched in January 2001 as a free encyclopedia that anyone can edit<Cite n={wikiHistory} />, it runs on the open-source <a href="https://en.wikipedia.org/wiki/MediaWiki">MediaWiki</a> software, which keeps a full revision history for every page<Cite n={mediaWiki} />. Its pages are plain and text-first, so they load quickly on slow connections and old devices. The project is run by volunteers through talk pages and consensus, flags unsourced claims with the "citation needed" tag<Cite n={citationNeeded} />, and is funded by donations to the Wikimedia Foundation rather than advertising<Cite n={wikimedia} />.</p>

      <h3>The 16-bit era</h3>
      <p>Dvij's first console was a Game Boy, and the design language of the 16-bit era, with its crisp pixel art, simple controls, and levels that teach through play, carried straight into the free browser games he grew up on. The Sega Genesis and the Super Nintendo brought richer color and sound to home consoles running from small cartridges<Cite n={fourthGen} />. Worlds were built from small reusable tiles and sprites with tight color palettes, and techniques such as the Super Nintendo's <a href="https://en.wikipedia.org/wiki/Mode_7">Mode 7</a> faked 3D depth on flat hardware<Cite n={mode7} />. A fixed hardware budget forced hard choices about what to keep and what to cut, a constraint that became a style games still borrow today.</p>

      <h3>Urban planning and walkable cities</h3>
      <p>Dvij loves urban planning, walkable cities, and public transit, and that is why this site is a city. Creators and organizations such as <a href="https://www.youtube.com/@CityBeautiful">City Beautiful</a>, <a href="https://www.strongtowns.org/">Strong Towns</a>, and <a href="https://www.youtube.com/@NotJustBikes">Not Just Bikes</a> are a big part of how he got into it. The case for walkable cities is that daily life works better when it is reachable on foot, by bike, and by transit, not only by car, and Strong Towns argues for small, incremental changes that a town can afford to maintain instead of giant projects it cannot<Cite n={strongTowns} />. In Dvij City, visitors explore on foot, the warp pipes run like a transit line between districts, and Downtown mixes glass towers, a digital billboard, and a corner restaurant on one street.</p>

      <h3>Games</h3>
      <p>Dvij also played a lot of free browser games growing up, and a few stuck. <a href="https://en.wikipedia.org/wiki/Super_Mario_Bros.">Super Mario</a> was one of the first games he ever played, and the green warp pipes that carry visitors around the city are a tribute. <a href="https://undertale.com/">Undertale</a> made him fall in love with the idea of gaming, and the underground layer of the city is a nod to it. The rest are staples of the browser-game years: the platformer <a href="https://www.coolmathgames.com/0-red-ball-4">Red Ball</a>, the two-player puzzler <a href="https://www.coolmathgames.com/0-fireboy-and-water-girl-in-the-forest-temple">Fireboy and Watergirl</a>, the endless runner <a href="https://www.coolmathgames.com/0-run-2">Run 2</a>, the ragdoll swinger <a href="https://www.kongregate.com/en/games/chribbe1/hanger">Hanger</a>, <a href="https://www.y8.com/games/top_spinner_cricket">Top Spinner Cricket</a>, the choose-your-path <a href="https://www.innersloth.com/games/the-henry-stickmin-collection/">Henry Stickmin</a> collection, and button-mashing stickman fighting games that are best played with a friend on the same keyboard.</p>

      <h3>What this site borrows</h3>
      <p>Dvij City takes three ideas from these influences. For optimization, every building, sprite, and font in the city is drawn in code with no image files, the Wiki view ships about 3 KB of JavaScript (gzipped) and reads fine with it turned off, and the city and each arcade game load only when requested. For creativity, tiles, small palettes, warp pipes, and an underground layer borrowed from the 16-bit playbook are used to tell a career story. For values, the site is <a href="https://en.wikipedia.org/wiki/Free_content">free</a> to read, with no accounts, no ads, and no tracking, and like Wikipedia the information is here for anyone who wants it.</p>
      <a class="city-link" href="#tour/museum" data-city-target="museum">See the Museum of Favourites in Dvij City</a>
    </section>

    <section id="references" aria-labelledby="refs-h">
      <h2 id="references-h">References</h2>
      <ul class="ext">
        {profile.colleagues.map((c) => (
          <li><a href={c.url}>{c.name}</a>{c.note && <span> ({c.note})</span>} on LinkedIn</li>
        ))}
      </ul>
      <ol class="refs">
        {refs.map((r) => <li id={r.id}><a href={r.href}>{r.label}</a></li>)}
      </ol>
    </section>
  </main>
  </div>

  <button type="button" class="tour-float" data-set-mode="city" hidden>
    <span class="px-icon" aria-hidden="true"></span> Explore City
  </button>

  <footer class="wiki-foot">
    <p>This article was last edited by its subject. Prefer exploring? <button type="button" class="linklike" data-set-mode="city">Visit Dvij City</button>.</p>
    <p class="webring-slot" data-webring-slot></p>
  </footer>
</div>
