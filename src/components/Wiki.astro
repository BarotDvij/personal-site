---
import profile from '../../content/profile.json';
import Cite from './Cite.astro';
import PixelIcon from './PixelIcon.astro';
import Org from './Org.astro';
import { STRUCTURES } from '../scripts/city/world';
import { BUILT, EXHIBITS, HISTORY } from '../scripts/city/museum';

// Map each role and project to its building so the Wiki can link into the city.
const buildingFor = (match: (r: NonNullable<(typeof STRUCTURES)[number]['ref']>) => boolean) =>
  STRUCTURES.find((s) => s.ref && match(s.ref))?.id;
const roleBuilding = (org: string) => buildingFor((r) => r.type === 'role' && r.org === org);
const projectBuilding = (name: string) => buildingFor((r) => r.type === 'project' && r.name === name);

// Footnotes: every claim that has public proof gets a citation.
const refs: { id: string; label: string; href: string }[] = [];
const cite = (label: string, href: string) => {
  let i = refs.findIndex((r) => r.href === href);
  if (i < 0) {
    refs.push({ id: `ref-${refs.length + 1}`, label, href });
    i = refs.length - 1;
  }
  return i + 1;
};

const cityscapes = cite('CityScapes on Devpost', 'https://devpost.com/software/cityscape-b02jei');
// Cited in order of first appearance on the page (infobox, then the lead).
const summitProject = profile.projects.find((p) => p.name === 'SUMMIT Financial Learning')!;
const summit = cite(`${summitProject.name} source`, summitProject.links.code);
const urbanMarble = cite('Urban Marble on Devpost', 'https://devpost.com/software/urban-marble');
// Early life & education comes before Projects, so its refs are created first.
const wlooNews = cite('Embracing change, Waterloo Management Science and Engineering', 'https://uwaterloo.ca/management-science-engineering/news/embracing-change');
const wlooCalendar = cite('Management Engineering, Waterloo Undergraduate Calendar', 'https://uwaterloo.ca/academic-calendar/undergraduate-studies/catalog#/programs/HkzsJ1CRsh');
const decaDoc = cite('DECA Ontario, Marketing Competency (MC) document', 'https://deca.ca/documents/MC.pdf');
const decaVideo = cite('DECA ICDC recording on YouTube', 'https://youtu.be/2vD2lEhETNU?si=75cFrAoT5XMPi-X_&t=5589');
const projectRefs = profile.projects.map((p) => {
  const href = 'devpost' in p.links && p.links.devpost ? (p.links.devpost as string) : p.links.code;
  return cite(`${p.name} source`, href);
});

const current = profile.experience[0];
const sections = [
  ['early-life', 'Early life & education'],
  ['career', 'Career'],
  ['projects', 'Projects'],
  ['civic', 'Personal life'],
  ['awards', 'Awards'],
  ['influences', 'Influences'],
  ['talk', 'Contact'],
  ['references', 'References'],
];

// Influences reuses the museum's data so the article and the city never drift apart.
const influenceWings = HISTORY.filter((w) => w.lines !== BUILT);

const awardGroups = ['Dance', 'Business competitions', 'Junior Achievement', 'School'].map(
  (g) => [g, profile.awards.filter((a) => a.group === g)] as const,
);

const anchor = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<div class="wiki" id="wiki">
  <a class="skip" href="#article">Skip to article</a>
  <header class="wiki-bar">
    <button type="button" class="toc-toggle" aria-controls="toc" aria-expanded="false" aria-label="Contents">
      <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" shape-rendering="crispEdges">
        <path d="M2 3h2v2H2zM6 3h8v2H6zM2 7h2v2H2zM6 7h8v2H6zM2 11h2v2H2zM6 11h8v2H6z" fill="currentColor" />
      </svg>
    </button>
    <a class="wordmark" href="/" aria-label="dvijbarot.wiki home">
      <svg viewBox="0 0 16 16" width="28" height="28" aria-hidden="true" shape-rendering="crispEdges">
        <rect width="16" height="16" fill="var(--ink)" />
        <path d="M3 3h6v1h1v1h1v6h-1v1h-1v1H3zM5 5v6h3v-1h1V6H8V5z" fill="var(--paper)" />
        <rect x="12" y="11" width="2" height="2" fill="#e8c547" />
      </svg>
      <span>dvijbarot<b>.wiki</b></span>
    </a>
    <div class="bar-actions">
      <button type="button" class="ghost" data-open-settings aria-haspopup="dialog">Settings</button>
    </div>
  </header>

  <nav class="tabs" aria-label="Article views">
    <div class="tab-group">
      <a href="#article" aria-current="page">Article</a>
      <a href="#talk">Talk</a>
    </div>
    <div class="tab-group">
      <a href="#career">View history</a>
    </div>
  </nav>

  <div class="wiki-body">
  <nav class="toc" id="toc" aria-label="Contents">
    <div class="toc-title">Contents <button type="button" class="toc-hide" aria-controls="toc">hide</button></div>
    <ol>
      <li><a href="#article" data-toc="article">(Top)</a></li>
      {sections.map(([id, name]) => <li><a href={`#${id}`} data-toc={id}>{name}</a></li>)}
    </ol>
  </nav>

  <main class="article" id="article" tabindex="-1">
    <div class="sitenotice">
      <button type="button" class="notice-thumb" data-set-mode="city" aria-label="Open Dvij City">
        <img src="/city-banner.webp" alt="" width="5848" height="460" />
      </button>
      <div class="notice-text">
        <p><b>This article is also a city.</b> Every role and project below is a building you can walk into, with data pipelines running underground.</p>
        <button type="button" class="tour-btn" data-set-mode="city">
          <span class="px-icon" aria-hidden="true"></span> Explore Dvij City
        </button>
      </div>
    </div>

    <div class="title-row">
      <h1>{profile.name}</h1>
      <nav class="title-links" aria-label="Contact and profiles">
        <a href={profile.links.github} aria-label="GitHub" title="GitHub"><PixelIcon name="github" /></a>
        <a href={profile.links.devpost} aria-label="Devpost" title="Devpost"><PixelIcon name="devpost" /></a>
        <a href={profile.links.linkedin} aria-label="LinkedIn" title="LinkedIn"><PixelIcon name="linkedin" /></a>
        <a href={`mailto:${profile.links.email}`} aria-label={`Email ${profile.links.email}`} title="Email"><PixelIcon name="mail" /></a>
      </nav>
    </div>
    <p class="from">From dvijbarot.wiki, a living article about one builder</p>

    <aside class="infobox" aria-label="Quick facts">
      <div class="infobox-title">{profile.name}</div>
      {profile.photo.src ? (
        <img class="portrait photo" src={profile.photo.src} alt={profile.photo.alt} width="192" height="192" />
      ) : (
        <div class="portrait" role="img" aria-label="Portrait coming soon">
          <span>DB</span>
        </div>
      )}
      <p class="caption">Waterloo, Ontario</p>
      <button type="button" class="locator" data-set-mode="city" aria-label="Location in Dvij City. Open the city">
        <img src="/city-locator-night.webp" alt="" width="1440" height="512" loading="lazy" />
        <span class="pin" aria-hidden="true"></span>
      </button>
      <p class="caption">Location in Dvij City. <button type="button" class="linklike" data-set-mode="city">Explore</button></p>
      <table>
        <tbody>
          <tr><th scope="row">Occupation</th><td>{current.role}, <Org e={current} /></td></tr>
          <tr><th scope="row">Education</th><td><a href={profile.education.url}>{profile.education.school}</a><br /><small>{profile.education.degree}</small></td></tr>
          <tr><th scope="row">Disciplines</th><td>Product · Data · AI · Software · Marketing</td></tr>
          <tr>
            <th scope="row">Known for</th>
            <td>
              <ul>
                <li>0 to 1 product development</li>
                <li>Automating workflows</li>
                <li>Evaluation-driven agents</li>
                <li>3 hackathon wins in 7 days<Cite n={cityscapes} /></li>
              </ul>
            </td>
          </tr>
          <tr>
            <th scope="row">Links</th>
            <td class="infobox-links">
              <a href={profile.links.linkedin}>LinkedIn</a>
              <a href={profile.links.github}>GitHub</a>
              <a href={profile.links.devpost}>Devpost</a>
            </td>
          </tr>
        </tbody>
      </table>
    </aside>

    <p class="lead">
      <b>Dvij Barot</b> is a Management Engineering student at the <a href={profile.education.url}>{profile.education.school}</a> looking for <b>{profile.seeking}</b>. He works across
      AI engineering and enablement, <a href="https://en.wikipedia.org/wiki/Product_management">product management</a>, <a href="https://en.wikipedia.org/wiki/Data_engineering">data engineering</a>, and <a href="https://en.wikipedia.org/wiki/Software_development">software development</a>. Barot is
      currently holding the {current.role} position at <Org e={current} />, <Fragment set:html={current.now} />.
    </p>
    <p class="lead-more">
      Barot's work spans <a href="https://en.wikipedia.org/wiki/Marketing_strategy">marketing strategy</a>, <a href="https://en.wikipedia.org/wiki/Pipeline_(computing)">data pipelines</a>, LLM evaluation, and full-stack products<Cite n={summit} />. In one week in
      2026, Barot's teams placed first, second, and first at three hackathons<Cite n={cityscapes} /><Cite n={urbanMarble} />.
      Barot's working philosophy is summed up in one line: <q>{profile.philosophy}</q>
    </p>

    <section id="early-life" aria-labelledby="early-h">
      <h2 id="early-h">Early life &amp; education</h2>
      <p>
        Dvij Barot is in his third year of his undergraduate degree at the <a href={profile.education.url}>University of Waterloo</a> in the <a href="https://uwaterloo.ca/engineering/future-students/management-engineering">Management Engineering</a> program.{' '}
        Management Engineering is often described as a combination of <a href="https://en.wikipedia.org/wiki/Software_engineering">software engineering</a> and <a href="https://en.wikipedia.org/wiki/Industrial_engineering">industrial engineering</a>, with the University of Waterloo's program being considered a pioneer in the modernization of the industrial engineering field<Cite n={wlooNews} />, with courses ranging from Databases and Software Design, Probability and Statistics II, Algorithms and Data Structures, and Modelling in Operations Research to Introduction to Machine Learning and Organizational Behaviour<Cite n={wlooCalendar} />.{' '}
        Outside of class, he has been part of the Wat.AI Engineering Design Team and the Warriors Dance Team, and served as HSC President.
      </p>
      <p>
        Dvij also graduated with distinction from Huron Heights Secondary School in Kitchener, ON. He won the Dustin Picard Memorial Award of Integrity, a graduation award presented to a student who exemplifies the spirit of unfailing friendship, courage to stand up for people, respect for individuality, and above all, integrity.{' '}
        He was known to be one of the only drummers in the school, which meant he took part in all of the school bands and concerts (Jr. Band, Sr. Band, Jazz Band, and the MYART concert) by default. He was also the sole winner from his school's chapter in the <a href="https://deca.ca/v2/">DECA</a> competition at the provincial level for three consecutive years, and the only student to take part in the international competition (ICDC) during his time at the school<Cite n={decaDoc} /><Cite n={decaVideo} />.
      </p>
    </section>

    <section id="career" aria-labelledby="career-h">
      <h2 id="career-h">Career</h2>
      <div class="table-wrap">
      <table class="wikitable career-table">
        <thead>
          <tr><th scope="col">Dates</th><th scope="col">Organization</th><th scope="col">Role</th><th scope="col">Description</th></tr>
        </thead>
        <tbody>
          {profile.experience.map((e) => (
            <tr id={anchor(e.org)}>
              <td class="dates">{e.dates}</td>
              <th scope="row"><Org e={e} /><small>{e.place}</small></th>
              <td>{e.role}</td>
              <td>
                {e.summary}
                {roleBuilding(e.org) && (
                  <a class="city-link" href={`#tour/${roleBuilding(e.org)}`} data-city-target={roleBuilding(e.org)} aria-label={`See ${e.org} in Dvij City`}>See it in Dvij City</a>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    </section>

    <section id="projects" aria-labelledby="projects-h">
      <h2 id="projects-h">Projects</h2>
      <div class="project-grid">
        {profile.projects.map((p, i) => (
          <article class="project">
            <h3>
              {p.name}
              <Cite n={projectRefs[i]} />
            </h3>
            {'award' in p && p.award && <p class="award">{p.award}</p>}
            {'status' in p && p.status && <p class="award status">{p.status}</p>}
            <p>{p.tagline}</p>
            <p class="stack">{p.stack.join(' · ')}</p>
            {projectBuilding(p.name) && (
              <a class="city-link" href={`#tour/${projectBuilding(p.name)}`} data-city-target={projectBuilding(p.name)}>See it in Dvij City</a>
            )}
          </article>
        ))}
      </div>
    </section>

    <section id="civic" aria-labelledby="civic-h">
      <h2 id="civic-h">Personal life</h2>
      <ul>
        {profile.civic.map((c) => (
          <li><b>{c.title}.</b> {c.body}</li>
        ))}
      </ul>
      <a class="city-link" href="#tour/cityhall" data-city-target="cityhall">See it in Dvij City</a>
    </section>

    <section id="awards" aria-labelledby="awards-h">
      <h2 id="awards-h">Awards</h2>
      <h3>Hackathons</h3>
      <table class="wikitable">
        <caption>Results from one week in 2026</caption>
        <thead><tr><th scope="col">Place</th><th scope="col">Event</th><th scope="col">Project</th></tr></thead>
        <tbody>
          {profile.hackathons.map((h) => (
            <tr>
              <td class="place">{h.place}</td>
              <td>{h.event}</td>
              <td>{'link' in h && h.link ? <a href={h.link as string}>{h.project}</a> : h.project}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {awardGroups.map(([group, items]) => (
        <>
          <h3>{group}</h3>
          <ul class="awards">
            {items.map((a) => (
              <li>
                <b>{a.title}</b> <span class="award-meta">{a.issuer} · {a.date}</span>
                <br />{a.body}
              </li>
            ))}
          </ul>
        </>
      ))}
      <a class="city-link" href="#tour/halloffame" data-city-target="halloffame">See the trophy case in Dvij City</a>
    </section>

    <section id="influences" aria-labelledby="influences-h">
      <h2 id="influences-h">Influences</h2>
      <p>The ideas behind this site came from the games, websites, and cities I grew up with.</p>
      {influenceWings.map((w) => (
        <>
          <h3>{w.title}</h3>
          {w.personal && <p>{w.personal}</p>}
          <p>{w.intro}</p>
          <ul>
            {w.lines.map(([k, v]) => <li><b>{k}.</b> {v}</li>)}
          </ul>
          <p class="ext">{w.links.map((l, i) => <>{i > 0 && ' · '}<a href={l.href}>{l.label}</a></>)}</p>
        </>
      ))}
      <h3>Games</h3>
      <p>Free browser and console games shaped how I think about design and product. A few of my favourites:</p>
      <ul>
        {EXHIBITS.map((e) => <li><b>{e.title}.</b> {e.note}</li>)}
      </ul>
      <h3>What this site borrows</h3>
      {BUILT.map(([k, v]) => <p><b>{k}.</b> {v}</p>)}
      <a class="city-link" href="#tour/museum" data-city-target="museum">See the Museum of Favourites in Dvij City</a>
    </section>

    <section id="talk" aria-labelledby="talk-h">
      <h2 id="talk-h">Contact</h2>
      <p>Open to {profile.seeking} in forward deployed engineering, technical product management, data engineering, and AI engineering.</p>
      <ul class="contact">
        <li><a href={`mailto:${profile.links.email}`}>{profile.links.email}</a></li>
        <li><a href={profile.links.linkedin}>LinkedIn</a></li>
        <li><a href={profile.links.github}>GitHub</a></li>
        <li><a href={profile.links.devpost}>Devpost</a></li>
      </ul>
    </section>

    <section id="references" aria-labelledby="refs-h">
      <h2 id="references-h">References</h2>
      <ul class="ext">
        {profile.colleagues.map((c) => (
          <li><a href={c.url}>{c.name}</a>{c.note && <span> ({c.note})</span>} on LinkedIn</li>
        ))}
      </ul>
      <ol class="refs">
        {refs.map((r) => <li id={r.id}><a href={r.href}>{r.label}</a></li>)}
      </ol>
    </section>
  </main>
  </div>

  <button type="button" class="tour-float" data-set-mode="city" hidden>
    <span class="px-icon" aria-hidden="true"></span> Explore City
  </button>

  <footer class="wiki-foot">
    <p>This article was last edited by its subject. Prefer exploring? <button type="button" class="linklike" data-set-mode="city">Visit Dvij City</button>.</p>
    <p class="webring-slot" data-webring-slot></p>
  </footer>
</div>
