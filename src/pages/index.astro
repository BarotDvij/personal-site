---
import Base from '../layouts/Base.astro';
import Wiki from '../components/Wiki.astro';
import City from '../components/City.astro';
import Settings from '../components/Settings.astro';
import profile from '../../content/profile.json';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: 'https://dvijbarot.wiki',
  email: `mailto:${profile.links.email}`,
  jobTitle: profile.experience[0].role,
  worksFor: { '@type': 'Organization', name: profile.experience[0].org },
  alumniOf: { '@type': 'CollegeOrUniversity', name: profile.education.school },
  sameAs: [profile.links.linkedin, profile.links.github, profile.links.devpost],
  knowsAbout: ['Product management', 'Data engineering', 'AI engineering', 'Software development', 'Marketing'],
};
---

<Base
  title={`${profile.name} | Product, data, and AI`}
  description="Dvij Barot is a Waterloo Management Engineering student building across product, data, AI, and software. Read the article or explore Dvij City."
>
  <script type="application/ld+json" set:html={JSON.stringify(person)} />
  <Wiki />
  <City />
  <Settings />
  <div class="mode-wipe" aria-hidden="true"></div>
</Base>

<script>
  import '../scripts/main';
</script>
